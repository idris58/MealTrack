# Supabase project settings (used by the browser client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key (server only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Web Push / VAPID settings (required for browser notifications)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Server timezone setting
NOTIFICATION_TIMEZONE=Asia/Dhaka
